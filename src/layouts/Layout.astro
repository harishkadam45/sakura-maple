---
import '../styles/global.css';
import { langs, ui, type Lang } from '../data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const abs = (path: string) => new URL(path, Astro.site).href;
const canonical = abs(langs[lang].home);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.metaTitle}</title>
    <meta name="description" content={t.metaDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={abs(langs.en.home)} />
    <link rel="alternate" hreflang="ja" href={abs(langs.ja.home)} />
    <link rel="alternate" hreflang="x-default" href={abs(langs.en.home)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.metaTitle} />
    <meta property="og:description" content={t.metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'ja' ? 'ja_JP' : 'en_CA'} />
    <meta name="theme-color" content="#0d0c0b" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500&family=Shippori+Mincho:wght@400;500;600&family=Zen+Kaku+Gothic+New:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Runs before first paint so the page never flashes the wrong theme.
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        var saved = function () {
          try {
            var v = localStorage.getItem('theme');
            return v === 'light' || v === 'dark' ? v : null;
          } catch (e) {
            return null;
          }
        };
        var system = window.matchMedia('(prefers-color-scheme: dark)');
        root.dataset.theme = saved() || (system.matches ? 'dark' : 'light');
        // Follow the device's day/night setting until the visitor picks a theme.
        system.addEventListener('change', function (e) {
          if (!saved()) root.dataset.theme = e.matches ? 'dark' : 'light';
        });
      })();
    </script>
  </head>
  <body id="top">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:bg-white focus:px-4 focus:py-2 focus:text-ink"
    >
      {t.skip}
    </a>
    <slot />
    <script>
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
      );
      items.forEach((el) => io.observe(el));
    </script>
  </body>
</html>
